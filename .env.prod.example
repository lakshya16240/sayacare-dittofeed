# Production environment for docker-compose.prod.yaml.
#
#   cp .env.prod.example .env.prod    # then fill in every REQUIRED value
#   chmod 600 .env.prod
#
# .env.prod is gitignored. This example file is not - keep real values out of it.

# ---------------------------------------------------------------------------
# Image (REQUIRED)
# ---------------------------------------------------------------------------
# Built by .github/workflows/docker-build-publish.yaml and pushed to GHCR.
IMAGE_REPOSITORY=ghcr.io/lakshya16240/dittofeed-lite
# Pin an immutable tag. `sha-<full-sha>` is emitted by every build; prefer it
# over `latest` so a redeploy cannot silently pick up different code.
IMAGE_TAG=sha-0000000000000000000000000000000000000000

# ---------------------------------------------------------------------------
# Secrets (REQUIRED - no usable defaults)
# ---------------------------------------------------------------------------
# Session cookie encryption key for single-tenant auth. MUST be 32 bytes of
# base64. Generate with:  openssl rand -base64 32
# The value shipped in docker-compose.lite.yaml is published in the public
# repo; using it lets anyone forge a valid session cookie.
SECRET_KEY=

# Dashboard login password. Compared as a plain string, so treat it as a
# shared secret and make it long. Generate with:  openssl rand -base64 24
PASSWORD=

DATABASE_USER=dittofeed
# openssl rand -base64 24
DATABASE_PASSWORD=

CLICKHOUSE_USER=dittofeed
# openssl rand -base64 24
CLICKHOUSE_PASSWORD=

# ---------------------------------------------------------------------------
# URLs (REQUIRED)
# ---------------------------------------------------------------------------
# The public origin, no trailing slash. This drives the allowed CORS origin
# and every link Dittofeed generates (unsubscribe, view-in-browser).
# Leaving it unset defaults to https://app.dittofeed.com in production.
DASHBOARD_URL=https://ditto.example.com

# Set false ONLY if you are serving plain HTTP. Over HTTPS leave it true.
SESSION_COOKIE_SECURE=true

# ---------------------------------------------------------------------------
# Workspace
# ---------------------------------------------------------------------------
# Used at bootstrap and passed to startLite on every boot. Changing it after
# bootstrap does not rename the workspace.
WORKSPACE_NAME=Saya

# ---------------------------------------------------------------------------
# Sizing - defaults assume an 8 GB VM. Container limit should exceed the heap
# by ~30%: max-old-space-size caps V8's heap only, not buffers or native
# memory, so a container capped at the heap size gets OOM-killed.
# ---------------------------------------------------------------------------
LITE_HEAP_MB=1536
LITE_MEM_LIMIT=2048m
WORKER_HEAP_MB=1536
WORKER_MEM_LIMIT=2048m
CLICKHOUSE_MEM_LIMIT=4096m
TEMPORAL_MEM_LIMIT=1024m

# Host port for the reverse proxy to forward to.
LITE_PORT=3000

# Interface the published port binds to. The default, 127.0.0.1, keeps it
# reachable only from the host, which is what you want with a reverse proxy or
# a Cloudflare tunnel in front. Set a tailnet address (100.x.y.z) to reach the
# dashboard over the tailnet instead.
#
# Do NOT set 0.0.0.0. Single-tenant auth is one shared password compared as a
# plain string, so that publishes the dashboard to the internet with only that
# in front of it.
# LITE_BIND=127.0.0.1

LOG_LEVEL=info

# Pins - change deliberately, not incidentally.
POSTGRES_VERSION=15
TEMPORAL_VERSION=1.22.4
